<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Your Advertising Campaign | 159.cash</title>
    <%- include('ledger/assets/css.ejs', { cssFiles: [ 'forms' ], page: 'campaign' }) %>
    <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller">
        <%- include('ledger/sidebarReduced', { currentPage: 'campaign' }) %>
        <%- include('ledger/sidebarMini') %>
        <div class="container-fluid page-body-wrapper">
            <div class="main-panel-noheader">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Your Advertising Campaign </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/operator">Cash</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Advertise</li>
                            </ol>
                        </nav>
                    </div>
                    <%- include('ledger/campaignDisplay') %>
                    <div class="col-lg-12 col-sm-6 grid-margin stretch-card">
                        <div class="card splash-text" style="text-align: left;">
                            <div class="card-body">
                                <h4 class="card-title">Campaign Rules & Restrictions</h4>
                                <p class="">
                                    When creating a new advertising campaign, please keep in mind that it must comply with 159.cash's 
                                    <a href="/tos" target="_blank">Terms of Service</a>. This includes but is not limited to a ban on 18+ or 'NSFW' content, 
                                    as well as phishing or distribiting dangerous software. All public campaings will be review by a human before they can be published on-site.<br>
                                    If you are unsure whether your campaign complies or want additional information feel free to <a href="/ticket">contact support</a>.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('ledger/footer') %>
            </div>
        </div>
    </div>
    <script src="/public/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/src/js/campaign.js"></script>
    <script src="/src/js/main.js"></script>
</body>

</html>