<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Contact Form | 159.cash</title>
  <%- include('ledger/assets/css.ejs', { cssFiles: [ 'forms' ] }) %>
  <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller">
        <%- include('ledger/index/sidebar', { currentPage: 'tickets' }) %>
        <%- include('ledger/sidebarMini') %>
        <div class="container-fluid page-body-wrapper">
            <div class="main-panel-noheader">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Contact </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="./">Cash</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Contact</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-xl-12 col-sm-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-9">
                                        <div class="d-flex align-items-center align-self-start">
                                            <i class="icon-md mdi mdi-comment-alert-outline text-warning ml-auto"></i>
                                            <h3 class="mb-0">&nbsp;&nbsp;&nbsp;For better & faster help, please join our 
                                                <a href="/discord" target="_blank">Discord server</a>.
                                            </h3>
                                            <p class="text-success ms-2 mb-0 font-weight-medium"></p>
                                        </div>
                                    </div>
                                </div>
                                <h6 class="text-muted font-weight-normal">
                                    Ask questions in the general chat, or create a ticket in the #ticket channel.
                                </h6>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title">Contact Form</h4>
                                    <form class="forms-sample" autocomplete="off" action="/sendEmail" method="POST">
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Full name">
                                        </div>
                                        <div class="form-group">
                                            <input type="email" class="form-control" id="email" name="email" placeholder="Email">
                                        </div>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="subject" name="subject" placeholder="Subject">
                                        </div>
                                        <div class="form-group" id="ticket-body">
                                            <textarea class="form-control" id="message" name="message" placeholder="Message" rows="10"></textarea>
                                        </div>
                                        <h6 class="text-muted font-weight-normal">
                                            Please allow up to 5 business days for a response.<br>
                                            ^ Tickets are sorted by oldest first so bumping will <b>not</b> improve response time, thank you.
                                        </h6><br>
                                        <button type="submit" class="btn btn-primary me-2" id="sendMessage">Send</button>
                                        <button class="btn btn-dark">Clear</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('ledger/footer') %>
            </div>
        </div>
    </div>
    <script src="/src/js/main.js"></script>
</body>

</html>