<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Your Ticket | 159.cash</title>
    <%- include('ledger/assets/css.ejs', { cssFiles: [ 'forms' ] }) %>
    <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller">
    <%- include('ledger/sidebarReduced', { currentPage: 'ticket' }) %>
    <%- include('ledger/sidebarMini') %>
        <div class="container-fluid page-body-wrapper">
            <div class="main-panel-noheader">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Your Ticket </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="./operator">Cash</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Contact</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="row">
                        <div class="col-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title text-muted">Ticket <%= ticket.shortID %></h4>
                                    <h3><%= ticket.title %></h3><br>
                                    <div class="d-flex align-items-center">
                                        <label class="text-primary" for="ticket-body"><%= user.username %></label>
                                        <p class="text-muted mb-0" style="margin-left: 1rem">
                                            <%= new Date(ticket.createdAt).toLocaleDateString("en-US", {
                                                month: "long",
                                                day: "numeric",
                                                year: "numeric"
                                            }) %>
                                        </p>
                                        <p class="text-muted mb-0" style="margin-left: 1rem">files: <%= ticket.files %></p>
                                    </div>
                                    <textarea class="form-control" name="ticket-body" style="width: 75%" readonly><%= ticket.body %></textarea>
                                    <% if (Array.isArray(ticket.messageHistory) && ticket.messageHistory.length > 0) { %>
                                        <% ticket.messageHistory.forEach(ticketMessage => { %>
                                            <br><div class="d-flex align-items-center">
                                                <% if (ticketMessage.from == "user") { %>
                                                    <label class="text-primary" for="message-body"><%= user.username %></label>
                                                <% } else { %>
                                                    <label class="text-danger" for="message-body">Admin</label>
                                                <% } %>
                                                <p class="text-muted mb-0" style="margin-left: 1rem">
                                                    <%= new Date(ticketMessage.date).toLocaleDateString("en-US", {
                                                        month: "long",
                                                        day: "numeric",
                                                        year: "numeric"
                                                    }) %>
                                                </p>
                                            </div>
                                            <textarea class="form-control" name="message-body" style="width: 75%" readonly><%= ticketMessage.message %></textarea>
                                        <% }); %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Send new message</h4>
                                <form class="forms-sample" autocomplete="off" action="/tickets/<%= ticket.shortID %>" method="POST"
                                    enctype="multipart/form-data">
                                    <% if (ticket.status == "resolved" || ticket.status == "closed") { %>
                                        <p class="text-danger">This ticket has been <%= ticket.status %>, no new messages can be sent.</p>
                                        <div class="form-group" id="message-body">
                                            <textarea class="form-control" id="messageBody" name="messageBody" placeholder="message" rows="10" maxlength="20000" 
                                                required disabled></textarea>
                                        </div>
                                        <button disabled type="submit" class="btn btn-primary me-2">Send</button>
                                        <button disabled type="reset" class="btn btn-dark">Clear</button>
                                    <% } else { %>
                                        <div class="form-group" id="message-body">
                                            <textarea class="form-control" id="messageBody" name="messageBody" placeholder="message" rows="10" maxlength="20000" 
                                                value="<%= data.messageBody || '' %>" required></textarea>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <button type="submit" class="btn btn-primary me-2">Send</button>
                                            <button type="reset" class="btn btn-dark" style="margin-left: 0.15rem">Clear</button>
                                            <p class="text-danger mb-0" style="margin-left: 1rem">
                                                <% if (typeof errors != 'undefined') { %>
                                                    <%= errors[0].msg %>
                                                <% } %>
                                            </p>
                                    <% } %>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('ledger/footer') %>
            </div>
        </div>
    </div>
    <script src="/src/js/main.js"></script>
</body>

</html>