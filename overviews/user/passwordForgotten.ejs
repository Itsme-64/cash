<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Forgot Password | 159.cash</title>
    <%- include('../ledger/assets/css.ejs', { cssFiles: [ 'auth', 'forms', 'socials' ] }) %>
    <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller-error">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper full-page-wrapper d-flex align-items-center auth login-bg">
                <div class="card col-lg-4 mx-auto">
                    <img src="/src/images/favicon.png" alt="159.cash favicon logo image" class="position-absolute authLogoImage">
                    <div class="card-body px-5 py-5 auth-card">
                        <h3 class="card-title text-start mb-3">Forgot Password</h3>
                        <% if (typeof(errors) != 'undefined') { %>
                            <p class="text-danger"><%= errors[0].msg %></p>
                        <% } %>
                        <% if (typeof(success) != 'undefined') { %>
                            <p class="text-success"><%= success %></p>
                        <% } %>
                        <form action="/password/forgot" method="POST">
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" class="form-control p_input" id="email" name="email" autocomplete="email" required
                                    value="<%= typeof data !== 'undefined' ? data?.email ?? "" : "" %>">
                            </div>
                            <div class="text-center d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-block enter-btn">Send Recovery Email</button>
                            </div>
                            <div class="d-flex">
                                <a class="btn btn-info me-2 col" href="/">
                                    <i class="mdi mdi-home-outline"></i> Return home </a>
                                <a class="btn btn-discord col" href="/discord" target="_blank">
                                    <i class="mdi mdi-message-processing-outline"></i> Discord </a>
                            </div>
                            <p class="sign-up">Don't have an Account?<a href="/register"> Sign Up</a></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/src/js/main.js"></script>
</body>

</html>