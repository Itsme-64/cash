<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Reset Password | 159.cash</title>
    <%- include('../ledger/assets/css.ejs', { cssFiles: [ 'auth', 'forms', 'socials' ] }) %>
    <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller-error">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper full-page-wrapper d-flex align-items-center auth login-bg">
                <div class="card col-lg-4 mx-auto">
                    <img src="/src/images/favicon.png" alt="159.cash favicon logo image" class="position-absolute authLogoImage">
                    <div class="card-body px-5 py-5 auth-card">
                        <h3 class="card-title text-start mb-3">Reset Password</h3>
                        <% if (typeof(errors) != 'undefined') { %>
                            <p class="text-danger"><%= errors[0].msg %></p>
                        <% } %>
                        <form action="/password/reset?token=<%= query.token %>" method="POST">
                            <div class="form-group position-relative">
                                <label for="newPassword">New password</label>
                                <input type="password" class="form-control countedInput" id="newPassword" minlength="8" name="newPassword"
                                    placeholder="strong password" autocomplete="new-password" required>
                                <small class="position-absolute bottom-0 end-0 pe-2 pb-1 text-danger counter"></small>
                            </div>
                            <div class="form-group position-relative">
                                <label for="newPasswordVerification">Re new password</label>
                                <input type="password" class="form-control countedInput" id="newPasswordVerification" minlength="8" name="newPasswordVerification"
                                    placeholder="same strong password" autocomplete="new-password" required>
                                <small class="position-absolute bottom-0 end-0 pe-2 pb-1 text-danger counter"></small>
                            </div>
                            <div class="text-center d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-block enter-btn">Reset Password</button>
                            </div>
                            <div class="d-flex">
                                <a class="btn btn-info me-2 col" href="/">
                                    <i class="mdi mdi-home-outline"></i> Return home </a>
                                <a class="btn btn-discord col" href="/discord" target="_blank">
                                    <i class="mdi mdi-message-processing-outline"></i> Discord </a>
                            </div>
                            <p class="sign-up">Don't have an Account?<a href="/register"> Sign Up</a></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/src/js/main.js"></script>
    <script src="/src/js/liveValidate.js"></script>
</body>

</html>