<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description"
        content="Register a new 159.cash account so you can start making unlimited ad-links today!" />
    <title>Register | 159.cash</title>
    <%- include('../ledger/assets/css.ejs', { cssFiles: [ 'auth', 'forms', 'socials' ] }) %>
    <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller-error">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper full-page-wrapper d-flex align-items-center auth login-bg">
                <div class="card col-lg-4 mx-auto">
                    <img src="/src/images/favicon.png" alt="159.cash favicon logo image" class="position-absolute authLogoImage">
                    <div class="card-body px-5 py-5">
                        <h3 class="card-title text-start mb-3">Register</h3>
                        <% if (typeof(errors) != 'undefined') { %>
                            <p class="text-danger"><%= errors[0].msg %></p>
                        <% } else if (errorMessages && errorMessages.length > 0) { %>
                            <p class="text-danger"><%= errorMessages[0] %></p>
                        <% } %>
                        <form action="/register" method="POST">
                            <input type="hidden" id="ref" name="ref" value="<%= ref %>">
                            <div class="form-group position-relative">
                                <div class="position-relative">
                                    <label for="username">Username *</label>
                                    <input type="text" class="form-control p_input pe-5 countedInput" name="username" id="username" minlength="4" 
                                        maxlength="400" autocomplete="username" required>
                                    <small class="position-absolute bottom-0 end-0 pe-2 pb-1 text-danger counter"></small>
                                </div>
                                <p id="usernameFeedback" style="margin-top: 0.25rem;"></p>
                            </div>
                            <div class="form-group">
                                <label for="email">Email *</label>
                                <input type="email" class="form-control p_input" name="email" id="email" autocomplete="email" required>
                            </div>
                            <div class="form-group position-relative">
                                <label for="password">Password *</label>
                                <input type="password" class="form-control p_input countedInput" name="password" id="password" minlength="8" 
                                    maxlength="400" autocomplete="new-password" required>
                                <small class="position-absolute bottom-0 end-0 pe-2 pb-1 text-danger counter"></small>
                            </div>
                            <p class="text-muted">
                                We need some information about you in order to process payouts, this can be added later.
                            </p>
                            <div class="form-group row">
                                <label for="name" class="col-sm-3 col-form-label">Full Name:</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="name" name="name" autocomplete="name">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="line1" class="col-sm-3 col-form-label">Address: (line 1)</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="line1" name="line1" autocomplete="address-line1">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="line2" class="col-sm-3 col-form-label">Address: (line 2)</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="line2" name="line2" autocomplete="address-line2">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="city" class="col-sm-3 col-form-label">City:</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="city" name="city">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="zipCode" class="col-sm-3 col-form-label">Zip Code:</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="zipCode" name="zipCode" autocomplete="postal-code">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="country" class="col-sm-3 col-form-label">Country</label>
                                <div class="col-sm-9">
                                    <select class="form-select" id="country" name="country" autocomplete="country">
                                        <%- include('../ledger/assets/countries') %>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group d-flex align-items-center justify-content-between">
                                <div class="form-check">
                                    <label class="form-check-label">
                                    <input type="checkbox" class="form-check-input" checked> Remember me </label>
                                </div>
                            </div>
                            <div class="text-center d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-block enter-btn">Sign up</button>
                            </div>
                            <div class="d-flex">
                                <a class="btn btn-info me-2 col" href="/">
                                    <i class="mdi mdi-home-outline"></i> Return home </a>
                                <a class="btn btn-discord col" href="/discord" target="_blank">
                                    <i class="mdi mdi-message-processing-outline"></i> Discord </a>
                            </div>
                            <p class="sign-up text-center">Already have an Account? 
                                <a href="/login">Log in</a>
                            </p>
                            <p class="terms">By creating an account you are accepting our 
                                <a href="/tos">Terms & Conditions</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/src/js/main.js"></script>
    <script src="/src/js/liveValidate.js"></script>
    <script src="/src/js/register.js"></script>
</body>

</html>