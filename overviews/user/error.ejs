<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title>Error <%= number %> | 159.cash</title>
        <%- include('../ledger/assets/css.ejs', { cssFiles: [] }) %>
        <link rel="shortcut icon" href="/src/images/favicon.png" />
    </head>
    <body>
        <div class="container-scroller-error">
            <div class="container-fluid page-body-wrapper full-page-wrapper">
                <% if (number >= 500 && number <= 599) { %>
                    <div class="content-wrapper d-flex align-items-center text-center error-page bg-info">
                    <% } else { %>
                    <div class="content-wrapper d-flex align-items-center text-center error-page bg-primary">
                <% } %>
                    <div class="row flex-grow">
                        <div class="col-lg-7 mx-auto text-white">
                            <div class="row align-items-center d-flex flex-row">
                                <div class="col-lg-6 text-lg-right pr-lg-4">
                                    <h1 class="display-1 mb-0"><%= number %></h1>
                                </div>
                                <div class="col-lg-6 error-page-divider text-lg-left pl-lg-4">
                                    <h2>SORRY!</h2>
                                    <h3 class="font-weight-light"><%= message %></h3>
                                </div>
                            </div>
                            <div class="row mt-5">
                                <div class="col-12 text-center mt-xl-2">
                                    <% if (redirect == "previous") { %>
                                        <a class="text-white font-weight-medium" href="javascript: history.go(-1)">Take me back!</a>
                                    <% } else if (redirect.includes('destination:')) { %>
                                        <a class="text-white font-weight-medium" href="<%= redirect.slice(12) %>">Continue to destination</a>
                                    <% } else { %>
                                        <a class="text-white font-weight-medium" href="/">Back to home</a>
                                    <% } %>
                                </div>
                            </div>
                            <div class="row mt-5">
                                <div class="col-12 mt-xl-2">
                                    <p class="text-white font-weight-medium text-center">Copyright © <span id="year"></span> 
                                      <a href="/index" target="_blank" class="link-light">159.Cash</a>. All rights reserved.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <script> document.getElementById("year").textContent = new Date().getFullYear(); </script>
    </body>
</html>