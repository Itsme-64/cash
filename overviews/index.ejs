<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description"
    content="159.Cash is a free and user-friendly tool that allows users to monetize and shorten their url links, with tools such as tracking, analytics, and direct support." />
  <title>159.cash</title>
  <%- include('ledger/assets/css.ejs', { cssFiles: [ 'forms' ], page: 'index' }) %>
  <link rel="shortcut icon" href="/src/images/favicon.png" />
</head>

<body>
    <div class="container-scroller">
        <%- include('ledger/index/sidebar', { currentPage: 'account' }) %>
        <%- include('ledger/sidebarMini') %>
        <div class="container-fluid page-body-wrapper">
            <%- include('ledger/index/navbar') %>
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="col-lg-12 col-sm-6 grid-margin stretch-card">
                        <div class="card splash-text">
                            <div class="card-body">
                                <h1 style="margin-bottom: -0.01rem;">Monetize Links Without Pissing Off Your Users</h1>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-6 col-sm-6 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title">The #1 ad-link shortening service</h4>
                                    <img class="index-logo-img" src="/src/images/logo-full.svg" alt="logo" />
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6 col-sm-6 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body d-flex flex-column justify-content-center">
                                    <h4 class="card-title text-center mb-4" style="text-align: left !important;">
                                        Visit your future user-experience
                                    </h4>
                                    <a href="/example" target="_blank" class="btn btn-info full-text-button w-100 h-60 d-flex justify-content-center align-items-center">
                                        <h2 class="md-0">Example Link</h2>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title">Why 159.Cash is <b>better</b></h4>
                                    <ul class="list-ticked">
                                        <li>Free</li>
                                        <p class="text-muted">159.Cash is completely free to use, forever.</p>
                                        <li>Fast redirects</li>
                                        <p class="text-muted">A set waiting time, <b>every time.</b> No unexpected hold ups or delays.</p>
                                        <li>User friendly</li>
                                        <p class="text-muted">
                                            No unexpected download, popups, or forced redirects. 159.Cash directly redirects your users 100% of the time.
                                        </p>
                                        <li>Easy to use</li>
                                        <p class="text-muted">Shorten unlimited custom links within seconds.</p>
                                        <li>Customizable</li>
                                        <p class="text-muted">
                                            Set your ad duration, or skip ads altogether for any link. Plus, get access to a personalized analytics dashboard.
                                        </p>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title">Dashboard Preview</h4>
                                    <img class="index-logo-img" src="/src/images/index/preview.webp" alt="159.cash user dashboard preview image" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title" style="text-align: center;">Additional Features</h4>
                                <div class="feature-container">
                                    <blockquote class="blockquote blockquote-info">Link redirect tracking</blockquote>
                                    <blockquote class="blockquote blockquote-info">Applying ads is optional</blockquote>
                                    <blockquote class="blockquote blockquote-info">Choose between 5, 10, and 15 seconds waiting time</blockquote>
                                    <blockquote class="blockquote blockquote-info">99.9% server uptime</blockquote>
                                    <blockquote class="blockquote blockquote-info">Monitor link-specific click and revenue data</blockquote>
                                    <blockquote class="blockquote blockquote-info">Advertise yourself on the 159.Cash platform</blockquote>
                                    <blockquote class="blockquote blockquote-info">Compatible with smartphones, tablets, and desktop</blockquote>
                                    <blockquote class="blockquote blockquote-info">Shorten links from any domain</blockquote>
                                    <blockquote class="blockquote blockquote-info">Request payout whenever you want ($10.- threshold)</blockquote>
                                    <blockquote class="blockquote blockquote-info">Ticket system and Discord community & support</blockquote>
                                    <blockquote class="blockquote blockquote-info">Secure HTTPS protocol</blockquote>
                                    <blockquote class="blockquote blockquote-info">Unlimited link traffic</blockquote>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title text-center mb-3">Our Content</h4>
                                <div class="row">
                                    <div class="col-md-6 grid-margin stretch-card">
                                        <div class="ratio ratio-16x9">
                                            <iframe src="https://www.youtube.com/embed/" frameborder="0" title="159.cash promotional video" allowfullscreen></iframe>
                                        </div>
                                    </div>
                                    <div class="col-md-6 grid-margin">
                                        <blockquote class="blockquote blockquote-primary w-100 text-center">
                                            <p class="h5">
                                                Confused? Watch our 
                                                <a href="https://youtube.com/watch?v=" target="_blank">video tutorial</a>.
                                            </p>
                                        </blockquote>
                                        <div class="d-flex justify-content-center">
                                            <img class="index-logo-img h-80 w-80" src="/src/images/index/hero.webp" 
                                                alt="159.cash rich man logo mascot caricature landing page image" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12 col-sm-6 grid-margin stretch-card">
                        <div class="card splash-text">
                            <a href="/register" id="registerButtonIndex">
                                <div class="card-body">
                                    <h1 style="margin-bottom: -0.01rem; color: white;">Sign Up <b>Now</b> To Start Earning <b>Today</b>!</h1>
                                </div>
                            </a>
                        </div>
                    </div>
                    <%- include('ledger/index/infoCards') %>
                </div>
                <%- include('ledger/footer') %>
            </div>
        </div>
    </div>
    <script src="/public/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/src/js/index.js"></script>
    <script src="/src/js/main.js"></script>
</body>

</html>