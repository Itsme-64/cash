<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Admin</title>
    <%- include('../ledger/assets/css.ejs', { cssFiles: [ 'forms', 'calendar' ] }) %>
    <link rel="shortcut icon" href="/src/images/favicon.png" />

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow: hidden;
        }
    </style>
</head>

<body data-done-dates="<%= doneDates %>">
    <div class="container-fluid page-body-wrapper">
        <div class="main-panel-noheader">
            <div class="content-wrapper">
                <div class="page-header">
                    <h3 class="page-title"> Admin Panel </h3>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/operator">159.cash</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Admin Panel</li>
                        </ol>
                    </nav>
                </div>
                <div class="row">
                    <div class="col-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Create a new Revenue Period</h4>
                                <form action="/admin/period/create" class="forms-sample" autocomplete="off" method="POST">
                                    <div class="calendar-row">
                                        <%- include('./calendarTemplate') %>
                                        <div class="calendar-container" style="grid: none;">
                                            <% const selectedPeriod = mostRecentPeriod %>
                                            <% if (selectedPeriod) { %>
                                                <div class="controls">
                                                    <strong class="label">
                                                        Period: 
                                                        <%= selectedPeriod?.fromDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                                                        &nbsp;-&nbsp;
                                                        <% selectedPeriod.toDate.setDate(selectedPeriod.toDate.getDate() - 1) %>
                                                        <%= selectedPeriod?.toDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                                                    </strong>
                                                    <p class="text-muted">
                                                        Applied:
                                                        <% if (selectedPeriod.applied) { %>
                                                            <span class="text-success">Yes</span>
                                                        <% } else { %>
                                                            <span class="text-danger">No</span>
                                                        <% } %>
                                                        | Amount: 
                                                        <span class="text-success"><%= selectedPeriod.amount %></span>
                                                    </p>
                                                </div>
                                                <div class="form-group row" style="margin: 0px;">
                                                    <label class="col-sm-4 col-form-label" for="paid">Paid Amount</label>
                                                    <div class="col-sm-7">
                                                        <input class="form-control" id="paid" name="paid" placeholder="<%= (selectedPeriod.paidAmount / 10000).toFixed(4) %>" readonly disabled>
                                                    </div>
                                                </div>
                                                <div class="form-group row" style="margin: 0px;">
                                                    <label class="col-sm-4 col-form-label" for="referral">Referral Amount</label>
                                                    <div class="col-sm-7">
                                                        <input class="form-control" id="referral" name="referral" 
                                                            placeholder="<%= (selectedPeriod.referralAmount / 10000).toFixed(4) %>" readonly disabled>
                                                    </div>
                                                </div>
                                                <div class="form-group row" style="margin: 0px;">
                                                    <label class="col-sm-4 col-form-label" for="admin">Admin Amount</label>
                                                    <div class="col-sm-7">
                                                        <input class="form-control" id="admin" name="admin" placeholder="<%= (selectedPeriod.adminAmount / 10000).toFixed(4) %>" readonly disabled>
                                                    </div>
                                                </div>
                                            <% } else { %>
                                                <div class="controls">
                                                    <strong class="label text-danger">NO RECENT PERIODS FOUND</strong>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="form-group hidden-label row">
                                        <div class="col">
                                            <label for="amount"></label>
                                            <input type="number" min="1" class="form-control" id="amount" name="amount" placeholder="Amount">
                                        </div>
                                        <div class="col">
                                            <label for="dateSelection"></label>
                                            <input type="text" class="form-control" id="dateSelection" name="dateSelection" 
                                                placeholder="MM/DD/YYYY - MM/DD/YYYY" readonly>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <button type="submit" class="btn btn-primary me-2">Send Earnings</button>
                                        <button type="reset" class="btn btn-dark" style="margin-left: 0.15rem">Clear</button>
                                        <p class="text-warning mb-0" style="margin-left: 1rem" id="monetization-warning"></p>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Pending Payouts</h4>
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Amount</th>
                                                <th>Recipient</th>
                                            </tr>
                                        </thead>
                                        <% if (Array.isArray(payouts) && payouts.length > 0) { %>
                                            <% payouts.slice().forEach(payout => { %>
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            <form action="/admin/payout/complete?payout=<%= payout.short %>" autocomplete="off" method="POST">
                                                                <button type="submit" title="mark complete" class="btn btn-info me-2">
                                                                    # <%= payout.short %>
                                                                </button>
                                                            </form>
                                                        </td>
                                                        <td>$ <span class="text-success"><%= payout.amount.toFixed(2) %></span></td>
                                                        <td>
                                                            <%= payout.payoutMethod.type == 'paypal' ? 
                                                                payout.payoutMethod.details?.email : 
                                                                payout.payoutMethod.details.btcAddress 
                                                            %>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            <% }); %>
                                        <% } else { %>
                                            <tbody>
                                                <tr>
                                                    <td>There are currently no pending payouts</td>
                                                    <td>#</td>
                                                    <td>#</td>
                                                </tr>
                                            </tbody>
                                        <% } %>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Pending Tickets</h4>
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Title</th>
                                                <th>Date</th>
                                                <th>Options</th>
                                            </tr>
                                        </thead>
                                        <% if (Array.isArray(tickets) && tickets.length > 0) { %>
                                            <% tickets.slice().forEach(ticket => { %>
                                                <tbody>
                                                    <tr>
                                                        <td style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            <a href="/admin/tickets/<%= ticket.short %>" target="_blank"># <%= ticket.short %></a>
                                                        </td>
                                                        <td style="max-width: 20ch;"><%= ticket.title %></td>
                                                        <td>
                                                            <%= new Date(ticket.updatedAt).toLocaleDateString("en-UK", { 
                                                                day: "numeric", 
                                                                month: "numeric", 
                                                                year: "numeric" 
                                                            }) %>
                                                        </td>
                                                        <td>
                                                            <div style="display: flex; flex-direction: row;">
                                                                <form action="/admin/ticket/resolve?ticket=<%= ticket.short %>" autocomplete="off" method="POST">
                                                                    <button type="submit" title="resolve ticket" class="btn btn-success me-2">
                                                                        <i class="mdi mdi-check-circle-outline"></i>
                                                                    </button>
                                                                </form>
                                                                <form action="/admin/ticket/close?ticket=<%= ticket.short %>" autocomplete="off" method="POST">
                                                                    <button type="submit" title="close ticket" class="btn btn-danger me-2">
                                                                        <i class="mdi mdi-cancel"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            <% }); %>
                                        <% } else { %>
                                            <tbody>
                                                <tr>
                                                    <td>There are currently no open tickets</td>
                                                    <td>#</td>
                                                    <td>#</td>
                                                    <td>#</td>
                                                </tr>
                                            </tbody>
                                        <% } %>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Past Revenue Periods</h4>
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Period</th>
                                                <th>Applied</th>
                                            </tr>
                                        </thead>
                                        <% if (Array.isArray(periods) && periods.length > 0) { %>
                                            <% periods.slice().forEach(period => { %>
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            Period: 
                                                            <%= period?.fromDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                                                            &nbsp;-&nbsp;
                                                            <% period.toDate.setDate(period.toDate.getDate() - 1) %>
                                                            <%= period?.toDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                                                        </td>
                                                        <td>
                                                            <% if (period.applied) { %>
                                                                <label class="badge badge-success">Applied</label>
                                                            <% } else { %>
                                                                <label class="badge badge-danger">Not Appl.</label>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            <% }); %>
                                        <% } else { %>
                                            <tbody>
                                                <tr>
                                                    <td>There are currently no recent periods</td>
                                                    <td>#</td>
                                                </tr>
                                            </tbody>
                                        <% } %>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Weight Values</h4>
                                <div class="chart-container" style="margin: 20px">
                                    <div id="weightsChart" 
                                        data-weights="<%= JSON.stringify([ weightValues ]) %>"
                                        data-dates="<%= JSON.stringify([ weightDates ]) %>">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Advertising Campaigns</h4>
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Title</th>
                                                <th>Status</th>
                                                <th>Options</th>
                                            </tr>
                                        </thead>
                                        <% if (Array.isArray(campaigns) && campaigns.length > 0) { %>
                                            <% campaigns.slice().forEach(campaign => { %>
                                                <tbody>
                                                    <tr>
                                                        <td style="max-width: 12ch;"><%= campaign.title %></td> <!-- this should become a link to go to the advertisement view -->
                                                        <td>
                                                            <% if (campaign.status == 'pending') { %>
                                                                <label class="badge badge-info">Pending</label>
                                                            <% } else if (campaign.status == 'active') { %>
                                                                <label class="badge badge-success">Active</label>
                                                            <% } else if (campaign.status == 'deactivated') { %>
                                                                <label class="badge badge-warning">Deactivated</label>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <div style="display: flex; flex-direction: row;">
                                                                <form action="/admin/campaign/approve?campaign=<%= campaign.short %>" autocomplete="off" method="POST">
                                                                    <button type="submit" title="approve campaign" class="btn btn-success me-2">
                                                                        <i class="mdi mdi-check-circle-outline"></i>
                                                                    </button>
                                                                </form>
                                                                <form action="/admin/campaign/remove?campaign=<%= campaign.short %>" autocomplete="off" method="POST">
                                                                    <button type="submit" title="remove campaign" class="btn btn-danger me-2">
                                                                        <i class="mdi mdi-cancel"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            <% }); %>
                                        <% } else { %>
                                            <tbody>
                                                <tr>
                                                    <td style="max-width: 20ch;">There are no current pending, active, or deactivated advertising campaigns.</td>
                                                    <td>#</td>
                                                    <td>#</td>
                                                </tr>
                                            </tbody>
                                        <% } %>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Space to add something! -->
                </div>
            </div>
            <%- include('../ledger/footer') %>
        </div>
    </div>
    <script src="/public/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/public/apexcharts/dist/apexcharts.min.js"></script>
    <script src="/src/js/admin.js"></script>
    <script src="/src/js/calendar.js"></script>
    <script src="/src/js/main.js"></script>
</body>

</html>