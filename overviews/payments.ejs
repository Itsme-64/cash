<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Payments | Ads.cash</title>
  <link rel="stylesheet" href="vendor/@mdi/font/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="assets/css/style.css">
  <link rel="shortcut icon" href="assets/images/favicon.png" />
</head>

<body>
  <div class="container-scroller">
  <%- include('ledger/sidebar', { currentPage: 'payments' }) %>
  <%- include('ledger/sidebarMini') %>
    <div class="container-fluid page-body-wrapper">
      <div class="main-panel-noheader">
        <div class="content-wrapper">
          <div class="page-header">
            <h3 class="page-title"> Payments </h3>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="./operator">Cash</a></li>
                <li class="breadcrumb-item active" aria-current="page">Payments</li>
              </ol>
            </nav>
          </div>
          <div class="row">
            <div class="col-md-6 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title" id="payment">Account Balance</h4>
                  <div class="form-group row">
                    <label for="exampleInputUsername2" class="col-sm-3 col-form-label">USD</label>
                    <div class="col-sm-9">
                      <input type="text" class="form-control text-success" id="balance" value="<%= user.balance %>"
                        readonly>
                    </div>
                  </div>
                  <p class="card-description"> Payment details:
                    <br><b>You </b>are responsible for assuring your
                    <a href="./you#payment">payment information</a> is set correctly<br>
                    <% if (!user.verified) { %>
                      <p class="text-danger">You must verify your account to request payments</p>
                    <% } else if (!user.name || !user.address.line1 || !user.address.city || !user.address.zip || !user.address.country) { %>
                      <p class="text-danger">Account information is incomplete</p>
                    <% } else if (user.balance < 10) { %>
                      <p class="text-danger">Minimum payout threshold is $10.-</p>
                    <% } else { %>
                      <p class="text-danger">You are able to request payout</p>
                    <% } %>
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title" id="password">Request Payout</h4>
                  <p class="card-description"> Automatic payouts are currently turned 
                    <% if (user.autoPayouts) { %>
                      <code>On</code>
                    <% } else { %>
                      <code>Off</code>
                    <% } %>
                    <a href="./you#autoPayment"> Manage</a><br>
                    <a href="./you#payment">Edit your payment information.</a>
                  </p>
                  <form class="forms-sample" action="/payment" method="post" autocomplete="off"> <!-- add action -->
                    <div class="form-group row">
                      <label for="amount" class="col-sm-3 col-form-label">Amount (USD)</label>
                      <div class="col-sm-9">
                        <input type="number" class="form-control text-success" id="amount" name="amount" min="10" max="1000" 
                          placeholder="10.00" value="<%= paymentData.amount || '' %> required">
                      </div>
                    </div>
                    <div class="d-flex align-items-center">
                      <button type="submit" class="btn btn-primary me-2"
                        <% if (!paymentsEnabled) { %>
                          disabled
                        <% } %>
                      >Request</button>
                      <p class="text-danger mb-0" style="margin-left: 1rem">
                        <% if (typeof errors != 'undefined') { %>
                          <%= errors[0].msg %>
                        <% } %>
                      </p>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
          <%- include('ledger/userPayments') %>
        </div>
        <%- include('ledger/footer') %>
      </div>
    </div>
  </div>
  <script src="vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="assets/js/main.js"></script>
</body>

</html>