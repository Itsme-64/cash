<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Your Referrals</h4>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Amount</th>
                            <th>Total Clicks</th>
                            <th>Total Earnings</th>
                            <th>Difference</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <% if (Array.isArray(referralAccounts) && referralAmount > 0) { %>
                                <% user.referrals.forEach(referral => { %>
                                    <td><!-- Display the month of the situation here --></td>
                                    <td><%= referralAmount %></td>
                                    <td><%= totalReferralClicks %></td>
                                    <td>USD <%= totalReferralEarnings %></td>
                                    <td 
                                        <% if (referralDifference > 0) { %>
                                            class="text-success"
                                        <% } else if (referralDifference < 0) { %>
                                            class="text-danger"
                                        <% } else { %>
                                            class="text-warning"
                                        <% } %>
                                    ><%= referralDifference %></td>
                                <% }); %>
                            <% } else { %>
                                <% const currentFormattedDate = new Date().toLocaleDateString(undefined, { month: 'long', year: 'numeric' }); %>
                                <td><%= currentFormattedDate %></td>
                                <td>0</td>
                                <td>0</td>
                                <td>USD 0.00</td>
                                <td class="text-warning">0</td>
                            <% } %>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>