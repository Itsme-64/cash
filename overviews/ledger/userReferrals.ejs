<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Your Referral Income Periods</h4>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Amount</th>
                            <th>Difference</th>
                            <th>Earnings</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (Array.isArray(referralData) && referralData.length > 0) { %>
                            <% referralData.forEach(period => { %>
                                <% const fromDate = period.fromDate.toLocaleString('default', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                <% const toDate = period.toDate.toLocaleString('default', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                <tr>
                                    <td><%= fromDate %> - <%= toDate %></td>
                                    <td><%= period.amount %></td>
                                    <td 
                                        <% if (period.difference > 0) { %>
                                            class="text-success"
                                        <% } else if (period.difference < 0) { %>
                                            class="text-danger"
                                        <% } else { %>
                                            class="text-warning"
                                        <% } %>
                                        ><%= period.difference %>
                                    </td>
                                    <td 
                                        <% if (period.income > 0) { %>
                                            class="text-success"
                                        <% } %>
                                        >$ <%= (period.income / 10000).toFixed(4) %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <% const origin = user.createdAt.toLocaleString('default', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            <% const today = new Date().toLocaleString('default', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            <tr>
                                <td><%= origin %> - <%= today %></td>
                                <td>0</td>
                                <td class="text-warning">0</td>
                                <td>USD 0.00</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>