<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title" id="updatePassword">Create A New Campaign</h4>
                <p class="card-description">Additional details can be filled out once the campaign has been created.</p>
                <p class="text-danger card-description">
                    <% if (typeof errors != 'undefined') { %>
                        <%= errors[0].msg %>
                    <% } %>
                </p>
                <form class="forms-sample" action="/advertise" method="post" autocomplete="off">
                    <div class="form-group row align-items-center">
                        <div class="col-md-7">
                            <label for="title">Title</label>
                            <input type="text" class="form-control" id="title" minlength="0" name="title" placeholder="campaign title..." required
                                value="<%= typeof data !== 'undefined' ? data?.title : "" %>">
                        </div>
                        <div class="col-md-5 d-flex align-items-center">
                            <div class="form-check mb-0">
                                <label for="business" class="form-check-label">
                                    <input type="checkbox" name="business" id="business" class="form-check-input">
                                    I am creating this campaign on behalf of a company
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group position-relative">
                        <label for="header">Header / Splash text</label>
                        <input type="text" class="form-control" id="header" minlength="12" name="header" placeholder="campaign header..." required
                            value="<%= typeof data !== 'undefined' ? data?.header : "" %>">
                    </div>
                    <div class="form-group position-relative">
                        <label class="form-check-label">
                            <span id="redirectInstantly-label">Redirect users instantly&nbsp;&nbsp;
                                <i class="mdi mdi-information-outline text" data-bs-toggle="tooltip" data-bs-placement="top" 
                                    title="Where do you want your campaign to redirect users to when they engage? This field should be a url, 
                                    for example https://example.com or mailto:user@email.com">
                                </i>
                            </span>
                        </label>
                        <input type="url" class="form-control" id="endpoint" name="endpoint" placeholder="campaign endpoint..." required
                            value="<%= typeof data !== 'undefined' ? data?.endpoint : "" %>">
                    </div>
                    <div class="d-flex align-items-center">
                        <select class="form-select" id="type" name="type" style="max-width: fit-content;">
                            <option value="personal">personal use only</option>
                            <option value="recurring">recurring online advertising</option>
                            <option value="one-time">one-time online advertising campaign</option>
                        </select>
                        <div class="ms-auto d-flex align-items-center">
                            <button type="submit" class="btn btn-primary me-2">Create</button>
                            <button type="reset" class="btn btn-dark">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-row justify-content-between">
                <h4 class="card-title mb-1">Your Campaigns</h4>
                <p class="text-muted mb-1">information</p>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="preview-list fixedHeightScrollable" id="userLinks">
                        <% if (Array.isArray(campaigns) && campaigns.length > 0) { %>
                            <% campaigns.slice().reverse().forEach(campaign => { %>
                                <div class="preview-item border-bottom scrollableCard">
                                    <% if (campaign.status == 'active') { %>
                                        <form action="/campaign/deactivate?campaign=<%= campaign.short %>" method="post" autocomplete="off">
                                    <% } %>
                                        <div class="preview-thumbnail">
                                            <button
                                                <% if (campaign.status == 'active') { %>
                                                    type="submit"
                                                <% } %>
                                                class="btn p-0 border-0 bg-transparent">
                                                <% if (campaign.status == 'draft') { %>
                                                    <div class="preview-icon-wide bg-warning" data-bs-toggle="tooltip" data-bs-placement="right" style="cursor: default;"
                                                        title="your campaign is currently a draft">
                                                        <i class="mdi mdi-link-variant text-light">drft</i>
                                                    </div>
                                                <% } else if (campaign.status == 'pending') { %>
                                                    <div class="preview-icon-wide bg-primary" data-bs-toggle="tooltip" data-bs-placement="right" style="cursor: default;"
                                                        title="your campaign is currently pending approval, please be patient and wait for it to be reviewd by an admin">
                                                        <i class="mdi mdi-link-variant-off text-light">pdng</i>
                                                    </div>
                                                <% } else if (campaign.status == 'active') { %>
                                                    <div class="preview-icon-wide bg-success" data-bs-toggle="tooltip" data-bs-placement="right" style="cursor: default;"
                                                        title="your campaign is actively running & displaying advertisements on 159.cash. It was last updated on 
                                                        <%= new Date(campaign.updatedAt)
                                                            .toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>">
                                                        <i class="mdi mdi-link-variant-off text-light">actv</i>
                                                    </div>
                                                <% } else if (campaign.status == 'deactivated') { %>
                                                    <div class="preview-icon-wide bg-warning"  data-bs-toggle="tooltip" data-bs-placement="right" style="cursor: default;"
                                                        title="your campaign is currently deactivated and thus not displaying advertisements online. 
                                                        If you did not deactivate it yourself you might need to supply additional funding for reinstatement">
                                                        <i class="mdi mdi-link-variant-off text-light">deac</i>
                                                    </div>
                                                <% } else if (campaign.status == 'removed') { %>
                                                    <div class="preview-icon-wide bg-danger"  data-bs-toggle="tooltip" data-bs-placement="right" style="cursor: default;"
                                                        title="your campaign has been permanently removed from 159.cash, 
                                                            if you want help regarding this situation contact support">
                                                        <i class="mdi mdi-link-variant-off text-light">remv</i>
                                                    </div>
                                                <% } %>
                                            </button>
                                        </div>
                                    <% if (campaign.status == 'active') { %>
                                        </form>
                                    <% } %>
                                    <div class="preview-thumbnail" style="margin-left: 16px;">
                                        <a href="/campaigns/<%= campaign.short %>" class="btn p-0 border-0 bg-transparent">
                                            <div class="preview-icon bg-info">
                                                <i class="mdi mdi-pencil-outline text-light"></i>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="preview-item-content d-sm-flex flex-grow"> 
                                        <div class="flex-grow">
                                            <h6 class="preview-subject"><%= campaign.title %></h6>
                                            <p class="text-muted mb-0" style="max-width: 30vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <a class="text-muted" href="<%= campaign.endpoint %>"><%= campaign.endpoint %></a>
                                            </p>
                                        </div>
                                        <div class="mr-auto text-sm-right pt-2 pt-sm-0">
                                        <!-- above give some basic campaign analytics (todo) and below say information about remaining budget and such -->
                                            <p>
                                                <span><%= 'campaign analytics should show here' %> clicks</span>
                                            </p>
                                            <p class="text-muted mb-0">Remaining: 
                                                <% if (campaign.active > 0.1) { %>
                                                    <span class="text-success"><%= (campaign.active / 10000).toFixed(4) %></span>
                                                <% } else { %>
                                                    <span class="text-warning"><%= (campaign.active / 10000).toFixed(4) %></span>
                                                <% } %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="preview-item border-bottom">
                                <div class="preview-thumbnail">
                                    <div class="preview-icon bg-info">
                                        <i class="mdi mdi-exclamation-thick"></i>
                                    </div>
                                </div>
                                <div class="preview-item-content d-sm-flex flex-grow">
                                    <div class="flex-grow">
                                        <h6 class="preview-subject">You don't have campaigns yet!</h6>
                                        <p class="text-muted mb-0">Create one using the form above</p>
                                    </div>
                                    <div class="mr-auto text-sm-right pt-2 pt-sm-0">
                                        <p class="text-muted"></p>
                                        <p class="text-muted mb-0"></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>