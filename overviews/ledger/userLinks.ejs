<div class="col-md-<%= width %> grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-row justify-content-between">
                <h4 class="card-title mb-1">Shortened Links</h4>
                <p class="text-muted mb-1">data</p>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="preview-list">
                        <% if (Array.isArray(links) && links.length > 0) { %>
                            <% links.forEach(link => { %>
                                <div class="preview-item border-bottom">
                                    <div class="preview-thumbnail">
                                        <div class="preview-icon bg-primary">
                                            <i class="mdi mdi-link-variant"></i> <!-- be able to click on this icon to deavtivate, red overlay & deactivated link icon - successful links will have color bg-success -->
                                        </div>
                                    </div>
                                    <div class="preview-item-content d-sm-flex flex-grow"> 
                                        <div class="flex-grow">
                                            <h6 class="preview-subject"><%= link.short %></h6>
                                            <p class="text-muted mb-0"><a href="<%= link.full %>"><%= link.full %></a></p>
                                        </div>
                                        <div class="mr-auto text-sm-right pt-2 pt-sm-0">
                                            <p class="text-muted"><%= link.clicks %></p>
                                            <p class="text-muted mb-0"><%= link.createdAt %></p>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="preview-item border-bottom">
                                <div class="preview-thumbnail">
                                    <div class="preview-icon bg-info">
                                        <i class="mdi mdi-exclamation-thick"></i>
                                    </div>
                                </div>
                                <div class="preview-item-content d-sm-flex flex-grow">
                                    <div class="flex-grow">
                                        <h6 class="preview-subject">You don't have any links yet!</h6>
                                        <p class="text-muted mb-0">Create one <a href="./new">now</a>!</p>
                                    </div>
                                    <div class="mr-auto text-sm-right pt-2 pt-sm-0">
                                        <p class="text-muted"></p>
                                        <p class="text-muted mb-0"></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>