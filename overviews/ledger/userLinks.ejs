<div class="col-md-<%= width %> grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-row justify-content-between">
                <h4 class="card-title mb-1">Shortened Links</h4>
                <p class="text-muted mb-1"><%= currentPage * 16 - 16 %> to <%= currentPage === totalPages ? totalPages % 16 : currentPage * 16 %></p>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="preview-list fixedHeightScrollable" id="userLinks">
                        <% if (Array.isArray(links) && links.length > 0) { %>
                            <% links.slice().reverse().forEach(link => { %>
                                <div class="preview-item border-bottom scrollableCard">
                                    <div class="preview-thumbnail">
                                        <form action="/<%= link.short %>/status?source=<%= source %>" method="POST">
                                            <button type="submit" class="btn btn-link p-0 border-0 bg-transparent">
                                                <% if (link.status) { %>
                                                    <div class="preview-icon bg-primary" data-bs-toggle="tooltip" data-bs-placement="right" title="deactivate link">
                                                        <i class="mdi mdi-link-variant text-light"></i>
                                                    </div>
                                                <% } else { %>
                                                    <div class="preview-icon bg-danger" data-bs-toggle="tooltip" data-bs-placement="right" title="reactivate link">
                                                        <i class="mdi mdi-link-variant-off text-light"></i>
                                                    </div>
                                                <% } %>
                                            </button>
                                        </form>
                                    </div>
                                    <div class="preview-item-content d-sm-flex flex-grow"> 
                                        <div class="flex-grow">
                                            <h6 class="preview-subject">
                                                <% if (source == "new") { %>
                                                    <i data-copy="https://159.cash/<%= link.short %>" class="mdi mdi-content-copy text-muted copy-button"></i>
                                                <% } %>
                                                https://159.cash/<%= link.short %>
                                            </h6>
                                            <p class="text-muted mb-0" style="max-width: 30vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <a class="text-muted" href="<%= link.full %>"><%= link.full %></a>
                                            </p>
                                        </div>
                                        <div class="mr-auto text-sm-right pt-2 pt-sm-0">
                                            <p>
                                                <span><%= link.clicks %> clicks</span>
                                                <% if (source == "new") { %>
                                                    <span>&nbsp;|&nbsp;</span> 
                                                    <span
                                                        <% if (Number((link.pending / 10000).toFixed(4)) > 0) { %>
                                                            class="text-warning"
                                                        <% } %>
                                                        data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" 
                                                        title="Total earnings from this link" 
                                                        data-bs-title="    
                                                            <div class='text-start'>
                                                                <strong>Earned </strong>
                                                                <span class='text-success'>+$<%= (link.earned / 10000).toFixed(4) ?? '0' %></span><br>
                                                                <strong>Pending </strong>
                                                                <span class='text-warning'>≈$<%= (link.pending / 10000).toFixed(4) ?? '0' %></span><br>
                                                                <small class='text-muted'>All time</small>
                                                            </div>
                                                        ">
                                                        $<%= (Number((link.earned / 10000).toFixed(4)) + Number((link.pending / 10000).toFixed(4))) || '0' %>
                                                    </span>
                                                <% } %>
                                            </p>
                                            <p class="text-muted mb-0">
                                                <%= new Date(link.createdAt).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="preview-item border-bottom">
                                <div class="preview-thumbnail">
                                    <div class="preview-icon bg-info">
                                        <i class="mdi mdi-exclamation-thick"></i>
                                    </div>
                                </div>
                                <div class="preview-item-content d-sm-flex flex-grow">
                                    <div class="flex-grow">
                                        <h6 class="preview-subject">You don't have any links yet!</h6>
                                        <p class="text-muted mb-0">Create one <a href="/new">now</a>!</p>
                                    </div>
                                    <div class="mr-auto text-sm-right pt-2 pt-sm-0">
                                        <p class="text-muted"></p>
                                        <p class="text-muted mb-0"></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <% if (Array.isArray(links) && links.length > 16) { %>
                        <div class="mt-3">
                            <nav aria-label="Page navigation">
                                <ul class="pagination">
                                    <li class="page-item <%= currentPage === 1 ? 'active' : '' %>">
                                        <a class="page-link" href="?page=1#userLinks">1</a>
                                    </li>
                                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="?page=<%= currentPage - 1 %>#userLinks">&laquo;</a>
                                    </li>
                                    <% 
                                        let middlePages = [];
                                        if (totalPages <= 5) {
                                            for (let i = 2; i < totalPages; i++) middlePages.push(i);
                                        } else {
                                            let start = Math.max(2, currentPage);
                                            let end = Math.min(totalPages - 1, start + 1);
                                            middlePages = [start, end].filter((v, i, a) => a.indexOf(v) === i);
                                        }
                                    %>
                                    <% middlePages.forEach(page => { %>
                                        <li class="page-item <%= currentPage === page ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= page %>#userLinks"><%= page %></a>
                                        </li>
                                    <% }) %>
                                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="?page=<%= currentPage + 1 %>#userLinks">&raquo;</a>
                                    </li>
                                    <li class="page-item <%= currentPage === totalPages ? 'active' : '' %>">
                                        <a class="page-link" href="?page=<%= totalPages %>#userLinks"><%= totalPages %></a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>