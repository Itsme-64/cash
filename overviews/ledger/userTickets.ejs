<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Your Tickets</h4>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>ID</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <% if (Array.isArray(tickets) && tickets.length > 0) { %>
                        <% tickets.slice().forEach(ticket => { %>
                            <tbody>
                                <tr>
                                    <td style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        <a href="tickets/<%= ticket.short %>" target="_blank"><%= ticket.title %></a>
                                    </td>
                                    <td><%= new Date(ticket.updatedAt).toLocaleDateString("en-US", {
                                            month: "long",
                                            day: "numeric",
                                            year: "numeric"
                                        }) %>
                                    </td>
                                    <td># <%= ticket.short %></td>
                                    <td>
                                        <% if (ticket.status == 'open') { %>
                                            <label class="badge badge-info">Open</label>
                                        <% } else if (ticket.status == 'in progress') { %>
                                            <label class="badge badge-warning">In progress</label>
                                        <% } else if (ticket.status == 'resolved') { %>
                                            <label class="badge badge-success">Resolved</label>
                                        <% } else { %>
                                            <label class="badge badge-danger">Closed</label>
                                        <% } %>
                                    </td>
                                </tr>
                            </tbody>
                        <% }); %>
                    <% } else { %>
                        <tbody>
                            <tr>
                                <td>No user tickets</td>
                                <td>#</td>
                                <td>#</td>
                                <td>
                                    <label class="badge badge-dark">No status</label>
                                </td>
                            </tr>
                        </tbody>
                    <% } %>
                </table>
            </div>
        </div>
    </div>
</div>