<div class="col-12 grid-margin stretch-card">
    <div class="card 
        <% if (campaign.status == 'removed') { %>
            border-danger-subtle2
        <% } else if (campaign.status == 'draft' || campaign.status == 'deactivated' || campaign.status == 'pending') { %>
            border-warning-subtle2
        <% } else if (campaign.status == 'active') { %>
            border-success-subtle2
        <% } %>">
        <div class="card-body">
            <!-- create new campaign popup on main advertising page, fill in the small details and then be redirected here to make the rest and saved as draft. -->
            <div class="badge-row">
                <h2><%- campaign.title %></h2>
                <% if (campaign.status == 'pending') { %>
                    <span class="badge badge-info">Pending</span>
                <% } else if (campaign.status == 'active') { %>
                    <label class="badge badge-success">Active</label>
                <% } else if (campaign.status == 'deactivated') { %>
                    <label class="badge badge-warning">Deactivated</label>
                <% } else if (campaign.status == 'draft') { %>
                    <label class="badge badge-warning">Draft</label>
                <% } else if (campaign.status == 'removed') { %>
                    <label class="badge badge-danger">Removed</label>
                <% } %>
            </div>
            <div class="badge-row">
                <% if (campaign.status == 'removed') { %>
                    <a class="btn btn-info">Appeal Removal</a>
                <% } %>
            </div>
        </div>
    </div>
</div>
<form class="forms-sample" action="/campaign/update?campaign=<%= campaign.short %>" method="post">
    <div class="col-12 grid-margin stretch-card">
        <div class="card"> <!-- add a button to be able to edit these just like on account add an i icon that informs about the need to re-review -->
            <div class="card-body">
                <div class="form-group row" style="margin-bottom: 20px;">
                    <div class="col-sm-12 d-flex align-items-center gap-2" style="padding: 0;">
                        <input type="text" class="form-control" id="userEmail" value="<%- campaign.head %>" 
                            style="background-color: #191c24; border: none;" disabled readonly>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="endpoint" class="col-sm-2 col-form-label">Campaign Endpoint:</label>
                    <div class="col-sm-10 d-flex align-items-center gap-2">
                        <input type="url" class="form-control" id="endpoint" value="<%= campaign.endpoint %>" disabled readonly>
                        <% if (campaign.business == true) { %>
                            <p class="text-muted mb-0 d-flex align-items-center gap-1">
                                <i class="icon-sm mdi mdi-domain text-info ml-auto"></i>&nbsp;&nbsp;Business
                            </p>
                        <% } else { %>
                            <p class="text-muted mb-0 d-flex align-items-center gap-1">
                                <i class="icon-sm mdi mdi-account text-info ml-auto"></i>&nbsp;Personal
                            </p>
                        <% } %>
                    </div>
                </div>
                <hr>
                <div class="row">
    <!-- use the campaign type to determine what to show in terms of when users want to advertise it (day, month, recurring etc) -->
    <!-- please make a ticket if you want to reclaim some of your advertising budget (amount to reclaim must be greater than $10) -->
    <!-- tell users that the same content restrictions hold here as the site-wide ones for links, but also provide a quick summary (like no nsfw)66 -->

    <!-- LEFT SIDE: SPECIFICATIONS -->
    <div class="col-md-6">
        <h4 class="mb-3">Specifications</h4>

        <!-- Countries -->
        <div class="form-group row">
            <label for="countries" class="col-sm-4 col-form-label">Countries</label>
            <div class="col-sm-8">
                <select class="form-select" id="countries" name="specifications[countries]">
                    <option value="all" <%= typeof data !== 'undefined' ? (data?.specifications?.countries === 'all' ? 'selected' : '') : '' %>>All</option>
                    <option value="nl" <%= typeof data !== 'undefined' ? (data?.specifications?.countries === 'nl' ? 'selected' : '') : '' %>>Netherlands</option>
                    <option value="us" <%= typeof data !== 'undefined' ? (data?.specifications?.countries === 'us' ? 'selected' : '') : '' %>>United States</option>
                </select>
            </div>
        </div>

        <!-- Languages -->
        <div class="form-group row">
            <label for="languages" class="col-sm-4 col-form-label">Languages</label>
            <div class="col-sm-8">
                <select class="form-select" id="languages" name="specifications[languages]">
                    <option value="all">All</option>
                    <option value="oth">Others</option>
                    <option value="en">English</option>
                    <option value="es">Spanish</option>
                    <option value="ma">Mandarin Chinese</option>
                    <option value="ar">Arabic</option>
                    <option value="fr">French</option>
                    <option value="de">German</option>
                </select>
            </div>
        </div>

        <!-- Categories -->
        <div class="form-group row">
            <label for="categories" class="col-sm-4 col-form-label">Categories</label>
            <div class="col-sm-8">
                <input type="text" class="form-control"
                    id="categories"
                    name="specifications[categories]"
                    value="<%= typeof data !== 'undefined' ? (data?.specifications?.categories ?? 'all') : '' %>">
            </div>
        </div>

        <!-- Browser -->
        <div class="form-group row">
            <label for="browser" class="col-sm-4 col-form-label">Browser</label>
            <div class="col-sm-8">
                <select class="form-select" id="browser" name="specifications[browser]">
                    <option value="edge">Edge</option>
                    <option value="chrome">Chrome</option>
                    <option value="firefox">Firefox</option>
                    <option value="opera">Opera</option>
                    <option value="safari">Safari</option>
                    <option value="explorer">Internet Explorer</option>
                </select>
            </div>
        </div>

        <!-- OS -->
        <div class="form-group row">
            <label for="oss" class="col-sm-4 col-form-label">Operating System</label>
            <div class="col-sm-8">
                <select class="form-select" id="oss" name="specifications[oss]">
                    <option value="windows">Windows</option>
                    <option value="macos">macOS</option>
                    <option value="linux">Linux</option>
                    <option value="android">Android</option>
                    <option value="ios">iOS</option>
                    <option value="ipados">iPadOS</option>
                </select>
            </div>
        </div>

        <!-- Returning -->
        <div class="form-group row">
            <label for="returning" class="col-sm-4 col-form-label">Returning Users</label> <!-- still make good name for this and change to number input -->
            <div class="col-sm-8">
                <select class="form-select" id="returning" name="specifications[returning]">
                    <option value="-1">All</option>
                    <option value="0">New Only</option>
                    <option value="1">Returning Only</option>
                </select>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE: BUDGET -->
    <div class="col-md-6">
        <h4 class="mb-3">Budget</h4>

        <!-- Active Budget -->
        <div class="form-group row">
            <label for="active" class="col-sm-4 col-form-label">Active Budget</label>
            <div class="col-sm-8">
                <input type="number" class="form-control"
                    id="active"
                    name="budget[active]"
                    value="<%= typeof data !== 'undefined' ? (data?.budget?.active ?? 0) : 0 %>">
            </div>
        </div>

        <!-- Dates -->
        <div class="form-group row">
            <label for="dates" class="col-sm-4 col-form-label">Dates</label>
            <div class="col-sm-8">
                <input type="text" class="form-control"
                    id="dates"
                    name="budget[dates]"
                    value="<%= typeof data !== 'undefined' ? (data?.budget?.dates ?? '') : 0 %>">
            </div>
        </div>

        <!-- Times -->
        <div class="form-group row">
            <label for="times" class="col-sm-4 col-form-label">Times</label>
            <div class="col-sm-8">
                <input type="text" class="form-control"
                    id="times"
                    name="budget[times]"
                    value="<%= typeof data !== 'undefined' ? (data?.budget?.times ?? 'all day') : 0 %>">
            </div>
        </div>

        <!-- Daily Budget -->
        <div class="form-group row">
            <label for="daily" class="col-sm-4 col-form-label">Daily Budget</label>
            <div class="col-sm-8">
                <input type="number" class="form-control"
                    id="daily"
                    name="budget[daily]"
                    value="<%= typeof data !== 'undefined' ? (data?.budget?.daily ?? 0) : 0 %>">
            </div>
        </div>

        <!-- Target CPM -->
        <div class="form-group row">
            <label for="targetCpm" class="col-sm-4 col-form-label">Target CPM</label>
            <div class="col-sm-8">
                <input type="number" step="0.01" class="form-control"
                    id="targetCpm"
                    name="budget[targetCpm]"
                    value="<%= typeof data !== 'undefined' ? (data?.budget?.targetCpm ?? 1) : 0 %>">
            </div>
        </div>

    </div>
</div>
                
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center"> <!-- add a dropdown here where users can choose whether their campaign can only be used personally or to advertise on site. Also add this option on the creation screen dropdown (use: personal account use/public advertising use) -->
        <button type="submit" id="submitBtn" class="btn btn-primary me-2">
            <% if (campaign.status == 'draft' || campaign.status == 'pending') { %>
                Submit for review
            <% } else { %>
                Update & publish
            <% } %>
        </button>
        <a href="/advertise" class="btn border-danger me-2" style="margin-left: 0.15rem">Cancel</a>
        <button type="submit" id="submitBtn" class="btn border-warning me-2" style="margin-left: 0.15rem">Save as draft</button>
        <p class="text-danger mb-0" style="margin-left: 1rem">
            <% if (typeof errors !== 'undefined') { %>
                <%= errors[0].msg %>
            <% } %>
        </p>
        <label for="type" class="col-sm-4 col-form-label"></label>
        <select class="form-select" id="type" name="type">
            <option value="personal">personal use only</option>
            <option value="recurring">recurring online advertising</option>
            <option value="one-time">one-time online advertising campaign</option>
        </select>
    </div>
</form>

