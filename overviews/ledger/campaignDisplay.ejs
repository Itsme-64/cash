<div class="col-12 grid-margin stretch-card">
    <div class="card 
        <% if (campaign.status == 'removed') { %>
            border-danger-subtle2
        <% } else if (campaign.status == 'draft' || campaign.status == 'deactivated' || campaign.status == 'pending') { %>
            border-warning-subtle2
        <% } else if (campaign.status == 'active') { %>
            border-success-subtle2
        <% } %>">
        <div class="card-body">
            <!-- create new campaign popup on main advertising page, fill in the small details and then be redirected here to make the rest and saved as draft. -->
            <div class="badge-row">
                <h2><%- campaign.title %></h2>
                <% if (campaign.status == 'pending') { %>
                    <span class="badge badge-info">Pending</span>
                <% } else if (campaign.status == 'active') { %>
                    <label class="badge badge-success">Active</label>
                <% } else if (campaign.status == 'deactivated') { %>
                    <label class="badge badge-warning">Deactivated</label>
                <% } else if (campaign.status == 'draft') { %>
                    <label class="badge badge-warning">Draft</label>
                <% } else if (campaign.status == 'removed') { %>
                    <label class="badge badge-danger">Removed</label>
                <% } %>
            </div>
            <div class="badge-row">
                <% if (campaign.status == 'removed') { %>
                    <a class="btn btn-info">Appeal Removal</a>
                <% } %>
            </div>
        </div>
    </div>
</div>
<form class="forms-sample" action="/campaign/update?campaign=<%= campaign.short %>" method="post">
    <div class="col-12 grid-margin stretch-card">
        <div class="card"> <!-- add a button to be able to edit these just like on account add an i icon that informs about the need to re-review -->
            <div class="card-body">
                <div class="form-group row" style="margin-bottom: 20px;">
                    <div class="col-sm-12 d-flex align-items-center gap-2" style="padding: 0;">
                        <input type="text" class="form-control" id="userEmail" value="<%- campaign.head %>" 
                            style="background-color: #191c24; border: none;" disabled readonly>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="endpoint" class="col-sm-2 col-form-label">Campaign Endpoint:</label>
                    <div class="col-sm-10 d-flex align-items-center gap-2">
                        <input type="url" class="form-control" id="endpoint" value="<%= campaign.endpoint %>" disabled readonly>
                        <% if (campaign.business == true) { %>
                            <p class="text-muted mb-0 d-flex align-items-center gap-1">
                                <i class="icon-sm mdi mdi-domain text-info ml-auto"></i>&nbsp;&nbsp;Business
                            </p>
                        <% } else { %>
                            <p class="text-muted mb-0 d-flex align-items-center gap-1">
                                <i class="icon-sm mdi mdi-account text-info ml-auto"></i>&nbsp;Personal
                            </p>
                        <% } %>
                    </div>
                </div>
                <% if (campaign.type == 'recurring') { %>
                    <hr>
                    <div class="row">
                        <!-- use the campaign type to determine what to show in terms of when users want to advertise it (day, month, recurring etc) -->
                        <!-- please make a ticket if you want to reclaim some of your advertising budget (amount to reclaim must be greater than $10) -->
                        <!-- tell users that the same content restrictions hold here as the site-wide ones for links, but also provide a quick summary (like no nsfw) -->
                        <!-- add functionality to add a campaign of type private at link creation -->

                        <!-- for all of these dropdowns, if the user has already selected something make that persistently show here -->
                        <div class="col-md-6">
                            <h4 class="mb-3">Specifications</h4>
                            <div class="form-group row" data-group="countries"> <!-- Countries -->
                                <label class="col-sm-4 col-form-label">Countries</label>
                                <div class="col-sm-8">
                                    <div class="form-check mb-2" style="margin-top: 5px;">
                                        <div class="col-6">
                                            <input type="checkbox" class="form-check-input  group-all" value="all" <%= campaign.specifications?.countries == 'all' ? 'checked' : '' %>> Select all
                                        </div>
                                    </div>
                                    <div class="row d-none group-options" id="countries-options">
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="oth" <%= campaign.specifications?.countries?.includes('oth') ? 'checked' : '' %>> Others</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="us" <%= campaign.specifications?.countries?.includes('us') ? 'checked' : '' %>> United States</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="uk" <%= campaign.specifications?.countries?.includes('uk') ? 'checked' : '' %>> United Kingdom</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="cn" <%= campaign.specifications?.countries?.includes('cn') ? 'checked' : '' %>> China</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="pi" <%= campaign.specifications?.countries?.includes('pi') ? 'checked' : '' %>> Philippines</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="fr" <%= campaign.specifications?.countries?.includes('fr') ? 'checked' : '' %>> France</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[countries][]" value="de" <%= campaign.specifications?.countries?.includes('de') ? 'checked' : '' %>> Germany</div>
                                    </div>
                                    <input type="hidden" name="specifications[countries]" value="all" class="group-hidden">
                                </div>
                            </div>
                            <div class="form-group row" data-group="languages">
                                <label class="col-sm-4 col-form-label">Languages</label>
                                <div class="col-sm-8">
                                    <div class="form-check mb-2" style="margin-top: 5px;">
                                        <div class="col-6">
                                            <input type="checkbox" class="form-check-input group-all" value="all" <%= campaign.specifications?.languages == 'all' ? 'checked' : '' %>> Select all
                                        </div>
                                    </div>
                                    <div class="row d-none group-options">
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="oth" <%= campaign.specifications?.languages?.includes('oth') ? 'checked' : '' %>> Others</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="en" <%= campaign.specifications?.languages?.includes('en') ? 'checked' : '' %>> English</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="es" <%= campaign.specifications?.languages?.includes('es') ? 'checked' : '' %>> Spanish</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="cn" <%= campaign.specifications?.languages?.includes('cn') ? 'checked' : '' %>> Mandarin Chinese</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="ar" <%= campaign.specifications?.languages?.includes('ar') ? 'checked' : '' %>> Arabic</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="fr" <%= campaign.specifications?.languages?.includes('fr') ? 'checked' : '' %>> French</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[languages][]" value="de" <%= campaign.specifications?.languages?.includes('de') ? 'checked' : '' %>> German</div>
                                    </div>
                                    <input type="hidden" name="specifications[languages]" value="all" class="group-hidden">
                                </div>
                            </div>
                            <div class="form-group row" data-group="browser">
                                <label class="col-sm-4 col-form-label">Browser</label>
                                <div class="col-sm-8">
                                    <div class="form-check mb-2" style="margin-top: 5px;">
                                        <div class="col-6">
                                            <input type="checkbox" class="form-check-input group-all" value="all" <%= campaign.specifications?.browser == 'all' ? 'checked' : '' %>> Select all
                                        </div>
                                    </div>
                                    <div class="row d-none group-options">
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[browser][]" value="edge" <%= campaign.specifications?.browser?.includes('edge') ? 'checked' : '' %>> Edge</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[browser][]" value="chrome" <%= campaign.specifications?.browser?.includes('chrome') ? 'checked' : '' %>> Chrome</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[browser][]" value="firefox" <%= campaign.specifications?.browser?.includes('firefox') ? 'checked' : '' %>> Firefox</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[browser][]" value="opera" <%= campaign.specifications?.browser?.includes('opera') ? 'checked' : '' %>> Opera</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[browser][]" value="safari" <%= campaign.specifications?.browser?.includes('safari') ? 'checked' : '' %>> Safari</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[browser][]" value="explorer" <%= campaign.specifications?.browser?.includes('explorer') ? 'checked' : '' %>> Internet Explorer</div>
                                    </div>
                                    <input type="hidden" name="specifications[browser]" value="all" class="group-hidden">
                                </div>
                            </div>
                            <div class="form-group row" data-group="system">
                                <label class="col-sm-4 col-form-label">Operating System</label>
                                <div class="col-sm-8">
                                    <div class="form-check mb-2" style="margin-top: 5px;">
                                        <div class="col-6">
                                            <input type="checkbox" class="form-check-input group-all" value="all" <%= campaign.specifications?.system == 'all' ? 'checked' : '' %>> Select all
                                        </div>
                                    </div>
                                    <div class="row d-none group-options">
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[system][]" value="windows" <%= campaign.specifications?.system?.includes('windows') ? 'checked' : '' %>> Windows</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[system][]" value="macos" <%= campaign.specifications?.system?.includes('macos') ? 'checked' : '' %>> macOS</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[system][]" value="linux" <%= campaign.specifications?.system?.includes('linux') ? 'checked' : '' %>> Linux</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[system][]" value="android" <%= campaign.specifications?.system?.includes('android') ? 'checked' : '' %>> Android</div>
                                        <div class="col-6 text-muted"><input type="checkbox" class="form-check-input" name="specifications[system][]" value="ios" <%= campaign.specifications?.system?.includes('ios') ? 'checked' : '' %>> iOS</div>
                                    </div>
                                    <input type="hidden" name="specifications[system]" value="all" class="group-hidden">
                                </div>
                            </div>

                            <!-- Categories -->
                            <div class="form-group row">
                                <label for="categories" class="col-sm-4 col-form-label">Categories</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control"
                                        id="categories"
                                        name="specifications[categories]"
                                        value="<%= typeof data !== 'undefined' ? (data?.specifications?.categories ?? 'all') : '' %>">
                                </div>
                            </div>
                            <div class="form-group row"> <!-- Returning -->
                                <label for="returning" class="col-sm-4 col-form-label">Frequency cap</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control" name="specifications[returning]" placeholder="..." <%= campaign.specifications?.returning ? campaign.specifications.returning : '' %>>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h4 class="mb-3">Budget</h4>

                            <!-- Active Budget -->
                            <div class="form-group row">
                                <label for="active" class="col-sm-4 col-form-label">Active Budget</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control"
                                        id="active"
                                        name="budget[active]"
                                        value="<%= typeof data !== 'undefined' ? (data?.budget?.active ?? 0) : 0 %>">
                                </div>
                            </div>

                            <!-- Dates -->
                            <div class="form-group row">
                                <label for="dates" class="col-sm-4 col-form-label">Dates</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control"
                                        id="dates"
                                        name="budget[dates]"
                                        value="<%= typeof data !== 'undefined' ? (data?.budget?.dates ?? '') : 0 %>">
                                </div>
                            </div>

                            <!-- Times -->
                            <div class="form-group row">
                                <label for="times" class="col-sm-4 col-form-label">Times</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control"
                                        id="times"
                                        name="budget[times]"
                                        value="<%= typeof data !== 'undefined' ? (data?.budget?.times ?? 'all day') : 0 %>">
                                </div>
                            </div>

                            <!-- Daily Budget -->
                            <div class="form-group row">
                                <label for="daily" class="col-sm-4 col-form-label">Daily Budget</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control"
                                        id="daily"
                                        name="budget[daily]"
                                        value="<%= typeof data !== 'undefined' ? (data?.budget?.daily ?? 0) : 0 %>">
                                </div>
                            </div>

                            <!-- Target CPM -->
                            <div class="form-group row">
                                <label for="targetCpm" class="col-sm-4 col-form-label">Target CPM</label>
                                <div class="col-sm-8">
                                    <input type="number" step="0.01" class="form-control"
                                        id="targetCpm"
                                        name="budget[targetCpm]"
                                        value="<%= typeof data !== 'undefined' ? (data?.budget?.targetCpm ?? 1) : 0 %>">
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center">
        <button type="submit" id="submitBtn" class="btn btn-primary me-2">
            <% if (campaign.status == 'draft' || campaign.status == 'pending') { %>
                Submit for review
            <% } else { %>
                Update & publish
            <% } %>
        </button>
        <a href="/campaigns/<%= campaign.short %>" class="btn border-danger me-2" style="margin-left: 0.15rem">Cancel</a>
        <button type="submit" id="submitBtn" class="btn border-warning me-2" style="margin-left: 0.15rem">Save as draft</button>
        <p class="text-danger mb-0" style="margin-left: 1rem">
            <% if (typeof errors !== 'undefined') { %>
                <%= errors[0].msg %>
            <% } %>
        </p>
        <label for="type" class="col-sm-4 col-form-label"></label>
        <select class="form-select" id="type" name="type" id="type">
            <option value="personal" <%= campaign.type === 'personal' ? 'selected' : '' %>>personal use only</option>
            <option value="one-time" <%= campaign.type === 'one-time' ? 'selected' : '' %>>one-time online advertising campaign</option>
        </select>
    </div>
</form>

