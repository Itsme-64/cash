<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description"
    content="Ads.cash advertisement page" />
  <title>Ads.cash</title>
  <link rel="stylesheet" href="vendor/@mdi/font/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="assets/css/style.css">
  <link rel="shortcut icon" href="assets/images/favicon.png" />

    <style>
    body {
        display: flex !important;
        flex-direction: column !important;
        min-height: 100vh !important;
        overflow: hidden !important;
    }
    </style>
</head>

<body>
    <nav class="navbar p-0 fixed-top d-flex flex-row">
        <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
            <ul class="navbar-nav d-flex flex-row flex-wrap align-items-center gap-4 w-100">
                <li class="d-flex align-items-center gap-3">
                    <img class="index-logo-img" src="/assets/images/logo-full.svg" alt="logo" style="max-width: 15rem;"/>
                    <p class="mb-0 mb-0 d-none d-xl-block">The new #1 ad-link <br> shortening service</p>
                </li>
                <li class="vr mx-3 d-none d-lg-block"></li>
                <div class="flex-grow-1"></div>
                <% if (true) { %>
                    <li class="d-flex gap-2 justify-content-center justify-content-md-end">
                        <p class="text-muted mb-0 d-none d-lg-block">
                            The content shown below is an advertisement<br>
                            You will be redirected after the countdown
                        </p>
                        <h1 class="text-muted mb-0">5</h1>
                    </li>
                <% } else { %>
                    <li class="d-flex gap-2 flex-wrap justify-content-center justify-content-md-end">
                        <p class="text-muted mb-0 d-none d-lg-block">
                            The content shown below is an advertisement <br>
                            After the countdown, press 'Skip' to proceed
                        </p>
                        <a class="btn btn-success create-new-button" href="<%= url.full %>">Skip in 5s</a>
                    </li>
                <% } %>
                <div class="flex-grow-1"></div>
                <li class="d-flex justify-content-start">
                    <a class="btn btn-success" href="/register">
                        <span class="d-none d-md-inline">
                            Sign Up&nbsp;&nbsp;|&nbsp;&nbsp;
                        </span>
                        Start Earning Today
                    </a>
                </li>
            </ul>
        </div>
    </nav>
    <div class="ad-container" style="background-color: tomato;"> <!-- add a perfectly fitting body -->
        <!-- insert advertisements here -->
        <li class="nav-item nav-settings d-none d-lg-block">
            <a class="scroll-top" id="footerButton" style="bottom: 60px !important">
                <i class="mdi mdi-arrow-up"></i>
            </a>
        </li>
    </div> <!-- make a clickable dropdown button to view footer --> 
    <footer class="footer" id="footer">
        <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Copyright © <span id="year"></span> 
                <a href="/index" target="_blank">Ads.Cash</a>. All rights reserved.
            </span>
            <span class="text-muted float-none float-sm-end d-block mt-1 mt-sm-0 text-center">
                <a href="/reportAdvertisement?link=<%= url.short %>" target="_blank">Report Ad</a> - 
                <a href="/privacy" target="_blank">Privacy Policy</a> - 
                <a href="/tos" target="_blank">Terms of Service</a>
            </span>
        </div>
    </footer>
    <script src="vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/main.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const footerButton = document.getElementById("footerButton");
        const footer = document.getElementById("footer");
        const arrow = footerButton.querySelector("i");

        footerButton.onclick = function(e) {
            footer.classList.toggle("show");

            if (footer.classList.contains("show")) {
                arrow.style.transform = "rotate(180deg)";
            } else {
                arrow.style.transform = "rotate(0deg)";
            }
        };
    });
    </script>
</body>

</html>