  <meta name="monetag" content="0f79f8529aa6dbda3d3b08c57ff35fac"> <!-- Monetag Advertisements -->
  <title>159.cash</title>
  <%- include('../ledger/assets/css.ejs', { cssFiles: [ 'buttons' ], page: 'adPage' }) %>
  <link rel="shortcut icon" href="/src/images/favicon.png" />

    <style>
        .tooltip {
            font-size: 0.95rem !important;
            z-index: 9999 !important;
        }

        .tooltip-inner {
            max-width: 280px !important;
            padding: 0.6rem 0.9rem !important;
            line-height: 1.4 !important;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow: hidden;
        }
    </style>

    <!-- Advertisements -->

    <!-- Popunder (Adsterra) -->
    <script src="https://alibisboast.com/cc/30/43/cc3043692457c4feed773449146b91a9.js"></script>
    
    <!-- Vignette Banner (Monetag) PopUp -->
    <script> 
        (function(s){s.dataset.zone='10760536',s.src='https://izcle.com/vignette.min.js'})
        ([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))
    </script>

    <!-- In-Page Push (Monetag) Notification -->
    <script>
        (function(s){s.dataset.zone='10760749',s.src='https://nap5k.com/tag.min.js'})
        ([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))
    </script>
</head>

<body data-redirect-instantly="<%= url.redirectInstantly %>" 
      data-duration="<%= url.duration %>"
      data-url-short="<%= url.short %>"
      data-url-full="<%= target %>"
      data-click-id="<%= clickId %>">
    <div id="pause-overlay"></div>
    <nav class="navbar p-0 fixed-top d-flex flex-row">
        <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
            <ul class="navbar-nav d-flex flex-row flex-wrap align-items-center gap-4 w-100">
                <li class="d-flex align-items-center gap-3">
                    <a href="/"> 
                        <img class="index-logo-img" src="/src/images/logo-full.svg" alt="logo" style="max-width: 15rem;"/> 
                    </a>
                    <p class="mb-0 mb-0 d-none d-xl-block">
                        The new #1 ad-link <br> 
                        shortening service
                    </p>
                </li>
                <li class="vr mx-3 d-none d-lg-block"></li>
                <div class="flex-grow-1"></div>
                <% if (url.redirectInstantly) { %>
                    <li class="d-flex align-items-center gap-4 justify-content-center justify-content-md-end">
                        <p class="text-muted mb-0 d-none d-lg-block">
                            The content shown below is an advertisement<br>
                            You will be redirected after the countdown
                        </p>
                        <h1 class="text-muted mb-0" id="countdownText">-</h1>
                    </li>
                <% } else { %>
                    <li class="d-flex align-items-center gap-3 justify-content-center justify-content-md-end">
                        <p class="text-muted mb-0 d-none d-lg-block">
                            <i class="text-muted" data-bs-toggle="tooltip" data-bs-placement="bottom" id="tooltip-redirect"
                                title="Choose between setting immediate redirects or 'Skip' button options">
                            </i>
                            The content shown below is an advertisement <br>
                            After the countdown, press 'Skip' to proceed
                        </p>
                        <a class="btn btn-primary disabled" id="countdownButton" href="<%= target %>" disabled>Skip in -</a>
                        <i class="text-muted" data-bs-toggle="tooltip" data-bs-placement="top" id="tooltip-duration"
                            title="Set custom waiting times between 5 and 15 seconds">
                        </i>
                    </li>
                <% } %>
                <div class="flex-grow-1"></div>
                <li class="d-flex justify-content-start">
                    <a class="btn btn-primary" href="/register">
                        <span class="d-none d-md-inline">
                            Sign Up&nbsp;&nbsp;|&nbsp;&nbsp;
                            <i class="text-muted z-1001" data-bs-toggle="tooltip" data-bs-placement="bottom" id="tooltip-register"
                                title="What are you waiting for? Sign up now to start earning today!">
                            </i>
                        </span>
                        Start Earning Today
                    </a>
                </li>
            </ul>
        </div>
    </nav>
